// ----- Trivia -----
WHITESPACE = _{ " " | "\t" }
COMMENT    = _{ "#" ~ (!NEWLINE ~ ANY)* }
NEWLINE    = _{ "\r\n" | "\n" | "\r" }

// ----- Keywords (excluded from idents) -----
keyword = @{
    ("if" | "then" | "else" | "match" | "true" | "false")
    ~ !(ASCII_ALPHANUMERIC | "_")
}

// ----- Literals & identifiers -----
number   = @{ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT*)? }
string   = @{ "\"" ~ (!"\"" ~ ANY)* ~ "\"" }
bool     = @{ ("true" | "false") ~ !(ASCII_ALPHANUMERIC | "_") }
ident    = @{ !keyword ~ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
wildcard = @{ "_" ~ !(ASCII_ALPHANUMERIC | "_") }

// ----- Operator tokens -----
// Operator characters. Built-in op tokens forbid an op_char tail so that a
// longer sequence (e.g. `++`, `+>`) is never consumed as the built-in prefix.
op_char = _{ "!" | "$" | "%" | "&" | "*" | "+" | "-" | "/"
           | "<" | "=" | ">" | "?" | "@" | "^" | "|" | "~" }

power    = @{ ("**" | "^") ~ !op_char }
multiply = @{ "*" ~ !op_char }
divide   = @{ "/" ~ !op_char }
modulo   = @{ "%" ~ !op_char }
add      = @{ "+" ~ !op_char }
subtract = @{ "-" ~ !op_char }

eq        = @{ "==" ~ !op_char }
ne        = @{ "!=" ~ !op_char }
le        = @{ "<=" ~ !op_char }
ge        = @{ ">=" ~ !op_char }
lt        = @{ "<" ~ !op_char }
gt        = @{ ">" ~ !op_char }
not_match = @{ "!~" ~ !op_char }
match_op  = @{ "~" ~ !op_char }

logical_and = @{ "&&" ~ !op_char }
logical_or  = @{ "||" ~ !op_char }

// Prefix `-` and `!` are intentionally single-char (no `!op_char` lookahead)
// so `--5` and `!!true` keep stacking. `(--)` and `(!!)` can still be defined
// as custom infix operators since the infix builders look for a leading
// non-prefix context.
neg         = @{ "-" }
logical_not = @{ "!" }

assign = { "=" }

// User-defined operators. Each variant is bucketed by first character so the
// Pratt parser can assign OCaml-style precedence. `=>` and `->` are reserved
// for function and match arrows so they're excluded from the `=`/`-` buckets.
custom_op_pow  = @{ "**" ~ op_char+ }
custom_op_mult = @{ ("*" | "/" | "%") ~ op_char+ }
custom_op_add  = @{ "+" ~ op_char+ | "-" ~ !">" ~ op_char+ }
custom_op_cat  = @{ ("^" | "@") ~ op_char* }
custom_op_comp = @{ ("<" | ">" | "!" | "$") ~ op_char+ | "=" ~ !">" ~ op_char+ }
custom_op_and  = @{ "&" ~ op_char+ }
custom_op_or   = @{ "|" ~ op_char+ }

// Prefix operators must start with `?` or `~` and be at least two chars.
// `!` is excluded so the built-in `!` keeps stacking (`!!true`); custom
// prefixes named with `!` would be unreachable in prefix position anyway.
custom_prefix  = @{ ("?" | "~") ~ op_char+ }

// Parenthesized operator name. Acts as an identifier in expressions and
// patterns so users can bind and reference operators as plain functions:
// `(++) = (x, y) => x + y`, then `1 ++ 2` or `(++) 1 2` or `(++)(1, 2)`.
op_paren_name = @{ op_char+ }
op_paren      = { "(" ~ op_paren_name ~ ")" }

prefix_op  = _{ neg | logical_not | custom_prefix }
postfix_op = _{ call_args | dot_access | juxt_arg }

// `list.0` for list/tuple index, `dict.foo` for dict string-key lookup.
// `dot_index` is digits-only so `xs.0.1` chains as `(xs.0).1` rather than
// being read as a single decimal index.
dot_index  = @{ ASCII_DIGIT+ }
dot_access = { "." ~ (dot_index | ident) }

// Function application by juxtaposition: `f x` is `f(x)`. Each juxt_arg
// consumes one primary, so `f g h` chains left-associatively as `(f g) h`.
juxt_arg = { primary }
infix_op   = _{
      power
    | multiply | divide | modulo
    | add | subtract
    | eq | ne | le | ge | lt | gt
    | logical_and | logical_or
    | not_match | match_op
    | custom_op_pow
    | custom_op_mult
    | custom_op_add
    | custom_op_cat
    | custom_op_comp
    | custom_op_and
    | custom_op_or
}

// ----- Patterns -----
// `..` matches zero-or-more remaining elements; `..name` binds them.
pattern_rest = { ".." ~ ident? }
pattern_item = _{ pattern_rest | pattern }

pattern_list = { "[" ~ (pattern_item ~ ("," ~ pattern_item)* ~ ","?)? ~ "]" }

pattern_tuple = {
      "(" ~ ")"
    | "(" ~ pattern_item ~ "," ~ ")"
    | "(" ~ pattern_item ~ ("," ~ pattern_item)+ ~ ","? ~ ")"
}

// Dict-pattern keys are expressions (evaluated), values are sub-patterns.
pattern_dict_entry = { expr ~ ":" ~ pattern }
pattern_dict       = { "{" ~ (pattern_dict_entry ~ ("," ~ pattern_dict_entry)* ~ ","?)? ~ "}" }
pattern_set        = { "{" ~ pattern ~ ("," ~ pattern)* ~ ","? ~ "}" }

// `wildcard` and `bool` precede `ident` so they aren't shadowed. `op_paren`
// precedes `pattern_tuple` so `(++)` binds the operator name rather than
// being attempted as a one-element tuple (which would fail anyway).
pattern = _{
      pattern_list
    | op_paren
    | pattern_tuple
    | pattern_dict
    | pattern_set
    | number
    | string
    | bool
    | wildcard
    | ident
}

// ----- Collections (expressions) -----
list  = { "[" ~ (expr ~ ("," ~ expr)* ~ ","?)? ~ "]" }
tuple = {
      "(" ~ ")"
    | "(" ~ expr ~ "," ~ ")"
    | "(" ~ expr ~ ("," ~ expr)+ ~ ","? ~ ")"
}
dict_entry = { expr ~ ":" ~ expr }
dict       = { "{" ~ (dict_entry ~ ("," ~ dict_entry)* ~ ","?)? ~ "}" }
set        = { "{" ~ expr ~ ("," ~ expr)* ~ ","? ~ "}" }

// ----- Scope (block expression) -----
// `( stmts )`. Evaluates statements in order in a child environment that
// captures the enclosing lexical scope; new bindings are local to the block.
// The block's value is the value of the last statement (Unit if that statement
// is an assignment). To disambiguate from tuple / parenthesized-expression, a
// scope must contain either a single assignment or two-plus newline-separated
// statements. `(x)` remains a parenthesized expression; `(x = 1)` is a scope.
scope = {
      "(" ~ NEWLINE* ~ statement ~ (NEWLINE+ ~ statement)+ ~ NEWLINE* ~ ")"
    | "(" ~ NEWLINE* ~ assignment ~ NEWLINE* ~ ")"
}

// ----- Function literal -----
// Parameters are space-separated; commas are optional. Parens are optional for
// one or more parameters but required for zero: `() => 1`, `x => x + 1`,
// `a b c => a + b + c`, `(a, b, c) => ...`, `(a b c) => ...` all work.
params = {
      "(" ~ (ident ~ (","? ~ ident)* ~ ","?)? ~ ")"
    | ident ~ (","? ~ ident)*
}
function = { params ~ "=>" ~ expr }

// ----- If expression -----
if_expr = { "if" ~ expr ~ "then" ~ expr ~ "else" ~ expr }

// ----- Match expression -----
// Arms are separated by `,`. A newline still terminates the scrutinee so
// `match value\n  pat -> ...` parses (without it, juxtaposition would eat
// the first pattern as a function arg). Newlines around the comma are
// allowed so arms can be laid out across multiple lines. The scrutinee is
// optional: a match without one evaluates to a 1-arg function whose
// argument becomes the scrutinee.
match_arm  = { pattern ~ "->" ~ expr }
match_expr = {
    "match" ~ expr?
    ~ NEWLINE+
    ~ match_arm ~ ("," ~ NEWLINE* ~ match_arm)* ~ ","?
}

// ----- Function call (postfix) -----
call_args = { "(" ~ (expr ~ ("," ~ expr)* ~ ","?)? ~ ")" }

// ----- Primary expression -----
// `scope` precedes `tuple` / `(expr)` so `(x = 1)` and multi-statement blocks
// bind as blocks rather than failing the tuple/expr rules. `function` is first
// so `(x) => body` is read as a function rather than a parenthesized `x`.
primary = _{
      function
    | match_expr
    | if_expr
    | number
    | string
    | bool
    | list
    | dict
    | set
    | op_paren
    | scope
    | tuple
    | "(" ~ expr ~ ")"
    | ident
}

// ----- Expression -----
expr = {
    prefix_op* ~ primary ~ postfix_op*
    ~ (infix_op ~ prefix_op* ~ primary ~ postfix_op*)*
}

// ----- Statements -----
// LHS is a pattern, so `a = 1`, `[b, ..] = a`, `(x, y) = pair`, and
// `{ "k": v } = some_dict` all work.
assignment = { pattern ~ assign ~ expr }
statement  = _{ assignment | expr }

program = {
    SOI
    ~ NEWLINE*
    ~ (statement ~ (NEWLINE+ ~ statement)*)?
    ~ NEWLINE*
    ~ EOI
}
